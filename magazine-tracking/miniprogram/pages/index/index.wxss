.page {
  min-height: 100vh;
  padding: 0 0 28px;
  background: #ffffff;
  color: #333333;
}

.brand {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 14px 12px 10px;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: #c8161d;
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 2px;
}

.brand-text {
  flex: 1;
}

.title,
.box-title,
.card-title,
.panel-title,
.privacy-title,
.result-head {
  display: block;
  color: #222222;
  font-weight: 700;
  line-height: 1.4;
}

.title {
  font-size: 18px;
}

.disclaimer,
.hint,
.fine,
.meta,
.panel-copy,
.privacy-copy {
  display: block;
  color: #666666;
  font-size: 13px;
  line-height: 1.6;
}

.disclaimer {
  margin-top: 2px;
}

.goldbar {
  margin: 0 12px 10px;
  padding: 8px 10px;
  background: #f0a429;
  color: #ffffff;
  font-size: 13px;
  line-height: 1.5;
}

.box,
.panel,
.card,
.banner,
.privacy {
  margin: 0 12px 10px;
  border: 1px solid #d3d3d3;
  background: #ffffff;
}

.box-title,
.card-title {
  padding: 0 12px;
  height: 28px;
  line-height: 28px;
  background: #de8b21;
  color: #fff7d6;
  font-size: 14px;
}

.box-body,
.card-body,
.panel,
.privacy,
.banner {
  padding: 12px;
}

.privacy {
  border-color: #e7b4b4;
}

.privacy-title,
.panel-title,
.result-head {
  font-size: 16px;
}

.result-head {
  margin: 4px 12px 0;
}

.privacy-copy,
.panel-copy,
.hint,
.fine,
.meta,
.notice,
.ok,
.error {
  margin-top: 8px;
}

.label,
.fine {
  display: block;
  font-weight: 700;
  color: #333333;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 40px;
  margin-top: 6px;
  padding: 0 10px;
  border: 1px solid #732808;
  background: #ffffff;
  color: #222222;
  font-size: 16px;
}

.error,
.notice,
.ok,
.banner {
  color: #c8161d;
  font-size: 13px;
  line-height: 1.5;
}

.banner,
.panel.bad {
  border-color: #e7b4b4;
  background: #fff6f6;
}

.btn {
  min-height: 40px;
  border-radius: 2px;
  font-size: 14px;
}

.btn.primary {
  background: #de8b21;
  color: #fff7d6;
}

.btn.ghost {
  background: #ffffff;
  color: #732808;
  border: 1px solid #de8b21;
}

.btn[disabled] {
  opacity: 0.55;
}

.block {
  width: 100%;
  margin-top: 12px;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.row .btn {
  flex: 1 1 120px;
}

.stamp {
  display: inline-block;
  margin-top: 0;
  padding: 0 6px;
  border: 1px solid #de8b21;
  color: #c45c12;
  font-size: 12px;
}

.tracking {
  display: block;
  margin-top: 2px;
  color: #e44087;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-all;
}
