{
  "miniprogramRoot": "./",
  "projectname": "magazine-lookup",
  "description": "杂志订阅单号查询。appid 必须换成你自己的小程序 AppID，不要提交 AppSecret。",
  "appid": "",
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "uploadWithSourceMap": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "suffix", "value": ".md" }
    ],
    "include": []
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "condition": {}
}
