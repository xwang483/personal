page {
  background: #ffffff;
  color: #333333;
  font-size: 14px;
  line-height: 1.5;
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
}

button {
  margin: 0;
  padding: 0 12px;
  font-size: 14px;
  line-height: 40px;
  min-height: 40px;
}

button::after {
  border: none;
}
