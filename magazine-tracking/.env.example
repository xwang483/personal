# 复制为 .env.local 后填写。不要把填好的文件提交到仓库。
# 密码和会话密钥都由部署环境提供，程序里没有默认密码。

# 管理人员登录名
ADMIN_USERNAME=

# 至少 8 位。请自行生成长随机密码，不要使用示例。
ADMIN_PASSWORD=

# 至少 32 位。可用 openssl rand -base64 32 生成。
ADMIN_SESSION_SECRET=

# SQLite 文件位置。部署时请把这个目录挂到持久卷。
DATABASE_PATH=./data/shipments.sqlite

# 只有在反向代理后面才设为 1。默认不信任 X-Forwarded-For。
TRUST_PROXY=0
