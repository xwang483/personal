# 复制为 .env.local 后填写。不要把填好的文件提交到仓库。
# 密码和会话密钥都由部署环境提供，程序里没有默认密码。

# 管理人员登录名
ADMIN_USERNAME=

# 至少 8 位。请自行生成长随机密码，不要使用示例。
ADMIN_PASSWORD=

# 至少 32 位。可用 openssl rand -base64 32 生成。
ADMIN_SESSION_SECRET=

# SQLite 文件位置。部署时请把这个目录挂到持久卷。
DATABASE_PATH=./data/shipments.sqlite

# 只有在反向代理后面才设为 1。此时按 X-Forwarded-For 从右数
# TRUSTED_PROXY_HOPS 个地址（默认 1，也就是代理自己写下的最后一跳）。
# 不设 TRUST_PROXY 时，不把调用方自带的多段转发头当成不同访客。
TRUST_PROXY=0
TRUSTED_PROXY_HOPS=1

# 短信。本地用 console，验证码打在服务器日志里，不要用于生产。
# 生产用 aliyun：先在阿里云短信服务申请签名和验证码模板，模板变量名必须是 code。
SMS_PROVIDER=console
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 小程序「使用微信手机号验证」。需要已认证的非个人主体，并按次计费。
# 不填这两项时，小程序只能走上面的短信验证码。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
